		guiButtonType = {
			name = "Background"
			quadTextureSprite = "GFX_v2cmd_bg"
		}
		guiButtonType = {
			name = "close_button"
			quadTextureSprite = "GFX_main_close_button"
			position = { x = 676 y = 12 }
			Orientation = "UPPER_LEFT"
			shortcut = "ESCAPE"
		}
		guiButtonType = {
			name = "v2cmd_blocs"
			quadTextureSprite = "GFX_button_standard_144"
			position = { x = 22 y = 12 }
			buttonText = "Blocs"
			buttonFont = "vic_18_black"
			Orientation = "UPPER_LEFT"
		}
		guiButtonType = {
			name = "v2cmd_treaty"
			quadTextureSprite = "GFX_button_standard_144"
			position = { x = 520 y = 12 }
			buttonText = "Treaties"
			buttonFont = "vic_18_black"
			Orientation = "UPPER_LEFT"
		}
		instantTextBoxType = {
			name = "v2cmd_header"
			position = { x = 0 y = 16 }
			font = "vic_22"
			borderSize = { x = 0 y = 0 }
			maxWidth = 720
			maxHeight = 30
			text = "Console commands"
			format = centre
			fixedsize = yes
		}
		instantTextBoxType = {
			name = "v2cmd_line0"
			position = { x = 30 y = 58 }
			font = "vic_18"
			borderSize = { x = 0 y = 0 }
			maxWidth = 660
			maxHeight = 22
			text = "Open the console with ~ and type a command. Province ids: showprovinceid, then hover a province."
			format = left
			fixedsize = yes
		}
		instantTextBoxType = {
			name = "v2cmd_line2"
			position = { x = 30 y = 92 }
			font = "vic_18"
			borderSize = { x = 0 y = 0 }
			maxWidth = 660
			maxHeight = 22
			text = "POPULATION"
			format = left
			fixedsize = yes
		}
		instantTextBoxType = {
			name = "v2cmd_line3"
			position = { x = 30 y = 116 }
			font = "Arial12"
			borderSize = { x = 0 y = 0 }
			maxWidth = 660
			maxHeight = 18
			text = "convert_pop <prov> [culture|-|owner] [religion|-|owner] [filters]     change culture/religion"
			format = left
			fixedsize = yes
		}
		instantTextBoxType = {
			name = "v2cmd_line4"
			position = { x = 30 y = 136 }
			font = "Arial12"
			borderSize = { x = 0 y = 0 }
			maxWidth = 660
			maxHeight = 18
			text = "list_prov_cultures <prov>   /   list_prov_religions <prov>      pops: id | type | culture/religion | size"
			format = left
			fixedsize = yes
		}
		instantTextBoxType = {
			name = "v2cmd_line5"
			position = { x = 30 y = 156 }
			font = "Arial12"
			borderSize = { x = 0 y = 0 }
			maxWidth = 660
			maxHeight = 18
			text = "migrate_pop <from> <to> <filters>        move matching pops      e.g. migrate_pop 123 555 polish catholic"
			format = left
			fixedsize = yes
		}
		instantTextBoxType = {
			name = "v2cmd_line6"
			position = { x = 30 y = 176 }
			font = "Arial12"
			borderSize = { x = 0 y = 0 }
			maxWidth = 660
			maxHeight = 18
			text = "migrate_all_pops <FROM> <TO> [accepted] [filters]    TO's culture living in FROM, spread evenly"
			format = left
			fixedsize = yes
		}
		instantTextBoxType = {
			name = "v2cmd_line7"
			position = { x = 30 y = 196 }
			font = "Arial12"
			borderSize = { x = 0 y = 0 }
			maxWidth = 660
			maxHeight = 18
			text = "      e.g. migrate_all_pops GER POL      migrate_all_pops GER POL accepted"
			format = left
			fixedsize = yes
		}
		instantTextBoxType = {
			name = "v2cmd_line8"
			position = { x = 30 y = 216 }
			font = "Arial12"
			borderSize = { x = 0 y = 0 }
			maxWidth = 660
			maxHeight = 18
			text = "double_pop <prov> [filters]      scale_pop <prov> <percent> [filters]      (200 = double, 50 = half)"
			format = left
			fixedsize = yes
		}
		instantTextBoxType = {
			name = "v2cmd_line9"
			position = { x = 30 y = 236 }
			font = "Arial12"
			borderSize = { x = 0 y = 0 }
			maxWidth = 660
			maxHeight = 18
			text = "scale_country_pop <TAG> <percent> [filters]     whole country      e.g. scale_country_pop SER 200 serb"
			format = left
			fixedsize = yes
		}
		instantTextBoxType = {
			name = "v2cmd_line10"
			position = { x = 30 y = 256 }
			font = "Arial12"
			borderSize = { x = 0 y = 0 }
			maxWidth = 660
			maxHeight = 18
			text = "Filter = culture, religion, pop type (farmers) or pop id. A pop must match every filter."
			format = left
			fixedsize = yes
		}
		instantTextBoxType = {
			name = "v2cmd_line12"
			position = { x = 30 y = 286 }
			font = "vic_18"
			borderSize = { x = 0 y = 0 }
			maxWidth = 660
			maxHeight = 22
			text = "CULTURES AND CORES"
			format = left
			fixedsize = yes
		}
		instantTextBoxType = {
			name = "v2cmd_line13"
			position = { x = 30 y = 310 }
			font = "Arial12"
			borderSize = { x = 0 y = 0 }
			maxWidth = 660
			maxHeight = 18
			text = "accept_culture <TAG> [cultures]     unaccept_culture <TAG> <cultures>      (TAG alone = list)"
			format = left
			fixedsize = yes
		}
		instantTextBoxType = {
			name = "v2cmd_line14"
			position = { x = 30 y = 330 }
			font = "Arial12"
			borderSize = { x = 0 y = 0 }
			maxWidth = 660
			maxHeight = 18
			text = "add_core <TAG> <prov> [more]      remove_core <TAG> <prov> [more]      e.g. add_core SER 652 653"
			format = left
			fixedsize = yes
		}
		instantTextBoxType = {
			name = "v2cmd_line16"
			position = { x = 30 y = 360 }
			font = "vic_18"
			borderSize = { x = 0 y = 0 }
			maxWidth = 660
			maxHeight = 22
			text = "POWER BLOCS (Victoria 3 style)"
			format = left
			fixedsize = yes
		}
		instantTextBoxType = {
			name = "v2cmd_line17"
			position = { x = 30 y = 384 }
			font = "Arial12"
			borderSize = { x = 0 y = 0 }
			maxWidth = 660
			maxHeight = 18
			text = "bloc_add <name> <TAG> [more tags]  (forced)      bloc_invite <bloc> <TAG>  (the AI accepts or refuses)"
			format = left
			fixedsize = yes
		}
		instantTextBoxType = {
			name = "v2cmd_line18"
			position = { x = 30 y = 404 }
			font = "Arial12"
			borderSize = { x = 0 y = 0 }
			maxWidth = 660
			maxHeight = 18
			text = "bloc_identity <bloc> military|trade|empire|religious      bloc_leader <TAG>      bloc_info [bloc]"
			format = left
			fixedsize = yes
		}
		instantTextBoxType = {
			name = "v2cmd_line19"
			position = { x = 30 y = 424 }
			font = "Arial12"
			borderSize = { x = 0 y = 0 }
			maxWidth = 660
			maxHeight = 18
			text = "bloc_remove <TAG>     bloc_list     bloc_disband <name>     bloc_map [on|off]  (political map by bloc)"
			format = left
			fixedsize = yes
		}
		instantTextBoxType = {
			name = "v2cmd_line20"
			position = { x = 30 y = 444 }
			font = "Arial12"
			borderSize = { x = 0 y = 0 }
			maxWidth = 660
			maxHeight = 18
			text = "In a war, members join the side of the member involved. The Blocs panel shows cohesion and identity effects."
			format = left
			fixedsize = yes
		}
		instantTextBoxType = {
			name = "v2cmd_line21"
			position = { x = 30 y = 464 }
			font = "Arial12"
			borderSize = { x = 0 y = 0 }
			maxWidth = 660
			maxHeight = 18
			text = "Click a country on the map: an 'Invite ... to bloc' button appears next to the province window (leader only)."
			format = left
			fixedsize = yes
		}
		instantTextBoxType = {
			name = "v2cmd_line23"
			position = { x = 30 y = 494 }
			font = "vic_18"
			borderSize = { x = 0 y = 0 }
			maxWidth = 660
			maxHeight = 22
			text = "TREATIES"
			format = left
			fixedsize = yes
		}
		instantTextBoxType = {
			name = "v2cmd_line24"
			position = { x = 30 y = 518 }
			font = "Arial12"
			borderSize = { x = 0 y = 0 }
			maxWidth = 660
			maxHeight = 18
			text = "Click a province, press 'Treaty: ...' next to the province window to offer it or ask for it, then open Treaties."
			format = left
			fixedsize = yes
		}
		instantTextBoxType = {
			name = "v2cmd_line25"
			position = { x = 30 y = 538 }
			font = "Arial12"
			borderSize = { x = 0 y = 0 }
			maxWidth = 660
			maxHeight = 18
			text = "treaty <TAG> [give <ids>] [take <ids>]     treaty_propose     treaty_population [TAG]   (each side gets its own people)"
			format = left
			fixedsize = yes
		}
		instantTextBoxType = {
			name = "v2cmd_line27"
			position = { x = 30 y = 568 }
			font = "Arial12"
			borderSize = { x = 0 y = 0 }
			maxWidth = 660
			maxHeight = 18
			text = "Log: the_grand_loader.log next to v2game.exe. Population totals refresh on the next game day."
			format = left
			fixedsize = yes
		}
	}


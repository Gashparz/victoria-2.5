guiTypes = {
	# Tab in the top bar (created by TGCConvertPop.dll next to Military). Move it by editing position.
	windowType = {
		name = "v2cmd_tab"
		backGround = ""
		position = { x = 1090 y = 0 }
		size = { x = 124 y = 80 }
		moveable = 0
		dontRender = ""
		horizontalBorder = ""
		verticalBorder = ""
		fullScreen = no
		Orientation = "UPPER_LEFT"

		guiButtonType = {
			name = "v2cmd_tab_btn"
			quadTextureSprite = "GFX_topbar_button_military"
			position = { x = 0 y = 5 }
			clicksound = click
		}
		textBoxType = {
			name = "v2cmd_tab_shadow"
			position = { x = 1 y = 5 }
			font = "vic_18_black_bold"
			borderSize = { x = 0 y = 0 }
			text = "COMENZI"
			maxWidth = 124
			maxHeight = 32
			format = centre
			fixedsize = yes
		}
		textBoxType = {
			name = "v2cmd_tab_text"
			position = { x = 0 y = 4 }
			font = "vic_18_headline"
			borderSize = { x = 0 y = 0 }
			text = "COMENZI"
			maxWidth = 124
			maxHeight = 32
			format = centre
			fixedsize = yes
		}
		instantTextBoxType = {
			name = "v2cmd_tab_sub"
			position = { x = 0 y = 40 }
			font = "Arial12"
			borderSize = { x = 0 y = 0 }
			text = "consola"
			maxWidth = 124
			maxHeight = 16
			format = centre
			fixedsize = yes
		}
	}

	# Window opened by the tab
	windowType = {
		name = "v2cmd_window"
		backGround = "Background"
		position = { x = -360 y = -249 }
		size = { x = 720 y = 498 }
		moveable = 1
		dontRender = ""
		horizontalBorder = ""
		verticalBorder = ""
		fullScreen = no
		Orientation = "CENTER"

		guiButtonType = {
			name = "Background"
			quadTextureSprite = "GFX_v2cmd_bg"
		}
		guiButtonType = {
			name = "close_button"
			quadTextureSprite = "GFX_main_close_button"
			position = { x = 676 y = 12 }
			Orientation = "UPPER_LEFT"
			shortcut = "ESCAPE"
		}
		guiButtonType = {
			name = "v2cmd_blocs"
			quadTextureSprite = "GFX_button_standard_144"
			position = { x = 22 y = 12 }
			buttonText = "Blocuri"
			buttonFont = "vic_18_black"
			Orientation = "UPPER_LEFT"
		}
		instantTextBoxType = {
			name = "v2cmd_header"
			position = { x = 0 y = 16 }
			font = "vic_22"
			borderSize = { x = 0 y = 0 }
			maxWidth = 720
			maxHeight = 30
			text = "Comenzi de consola"
			format = centre
			fixedsize = yes
		}
		instantTextBoxType = {
			name = "v2cmd_line0"
			position = { x = 30 y = 58 }
			font = "vic_18"
			borderSize = { x = 0 y = 0 }
			maxWidth = 660
			maxHeight = 22
			text = "Deschide consola cu tasta ~ si scrie comanda. Id provincie: showprovinceid, apoi mouse pe provincie."
			format = left
			fixedsize = yes
		}
		instantTextBoxType = {
			name = "v2cmd_line2"
			position = { x = 30 y = 92 }
			font = "vic_18"
			borderSize = { x = 0 y = 0 }
			maxWidth = 660
			maxHeight = 22
			text = "POPULATIE"
			format = left
			fixedsize = yes
		}
		instantTextBoxType = {
			name = "v2cmd_line3"
			position = { x = 30 y = 116 }
			font = "Arial12"
			borderSize = { x = 0 y = 0 }
			maxWidth = 660
			maxHeight = 18
			text = "convert_pop <prov> [cultura|-|owner] [religie|-|owner] [filtre]     schimba cultura/religia"
			format = left
			fixedsize = yes
		}
		instantTextBoxType = {
			name = "v2cmd_line4"
			position = { x = 30 y = 136 }
			font = "Arial12"
			borderSize = { x = 0 y = 0 }
			maxWidth = 660
			maxHeight = 18
			text = "list_prov_cultures <prov>   /   list_prov_religions <prov>      pop-uri: id | tip | cultura/religie | marime"
			format = left
			fixedsize = yes
		}
		instantTextBoxType = {
			name = "v2cmd_line5"
			position = { x = 30 y = 156 }
			font = "Arial12"
			borderSize = { x = 0 y = 0 }
			maxWidth = 660
			maxHeight = 18
			text = "migrate_pop <din> <in> <filtre>        muta pop-urile potrivite      ex: migrate_pop 123 555 polish catholic"
			format = left
			fixedsize = yes
		}
		instantTextBoxType = {
			name = "v2cmd_line6"
			position = { x = 30 y = 176 }
			font = "Arial12"
			borderSize = { x = 0 y = 0 }
			maxWidth = 660
			maxHeight = 18
			text = "migrate_all_pops <DIN> <SPRE> [accepted] [filtre]    cultura lui SPRE din tara DIN, impartita egal"
			format = left
			fixedsize = yes
		}
		instantTextBoxType = {
			name = "v2cmd_line7"
			position = { x = 30 y = 196 }
			font = "Arial12"
			borderSize = { x = 0 y = 0 }
			maxWidth = 660
			maxHeight = 18
			text = "      ex: migrate_all_pops GER POL      migrate_all_pops GER POL accepted"
			format = left
			fixedsize = yes
		}
		instantTextBoxType = {
			name = "v2cmd_line8"
			position = { x = 30 y = 216 }
			font = "Arial12"
			borderSize = { x = 0 y = 0 }
			maxWidth = 660
			maxHeight = 18
			text = "double_pop <prov> [filtre]      scale_pop <prov> <procent> [filtre]      (200 = dublu, 50 = jumatate)"
			format = left
			fixedsize = yes
		}
		instantTextBoxType = {
			name = "v2cmd_line9"
			position = { x = 30 y = 236 }
			font = "Arial12"
			borderSize = { x = 0 y = 0 }
			maxWidth = 660
			maxHeight = 18
			text = "scale_country_pop <TAG> <procent> [filtre]     toata tara      ex: scale_country_pop SER 200 serb"
			format = left
			fixedsize = yes
		}
		instantTextBoxType = {
			name = "v2cmd_line10"
			position = { x = 30 y = 256 }
			font = "Arial12"
			borderSize = { x = 0 y = 0 }
			maxWidth = 660
			maxHeight = 18
			text = "Filtru = cultura, religie, tip de pop (farmers) sau id de pop. Toate filtrele trebuie sa se potriveasca."
			format = left
			fixedsize = yes
		}
		instantTextBoxType = {
			name = "v2cmd_line12"
			position = { x = 30 y = 286 }
			font = "vic_18"
			borderSize = { x = 0 y = 0 }
			maxWidth = 660
			maxHeight = 22
			text = "CULTURI SI CORE-URI"
			format = left
			fixedsize = yes
		}
		instantTextBoxType = {
			name = "v2cmd_line13"
			position = { x = 30 y = 310 }
			font = "Arial12"
			borderSize = { x = 0 y = 0 }
			maxWidth = 660
			maxHeight = 18
			text = "accept_culture <TAG> [culturi]     unaccept_culture <TAG> <culturi>      (doar TAG = lista)"
			format = left
			fixedsize = yes
		}
		instantTextBoxType = {
			name = "v2cmd_line14"
			position = { x = 30 y = 330 }
			font = "Arial12"
			borderSize = { x = 0 y = 0 }
			maxWidth = 660
			maxHeight = 18
			text = "add_core <TAG> <prov> [alte prov]      remove_core <TAG> <prov> [alte prov]      ex: add_core SER 652 653"
			format = left
			fixedsize = yes
		}
		instantTextBoxType = {
			name = "v2cmd_line16"
			position = { x = 30 y = 360 }
			font = "vic_18"
			borderSize = { x = 0 y = 0 }
			maxWidth = 660
			maxHeight = 22
			text = "BLOCURI (mega aliante)"
			format = left
			fixedsize = yes
		}
		instantTextBoxType = {
			name = "v2cmd_line17"
			position = { x = 30 y = 384 }
			font = "Arial12"
			borderSize = { x = 0 y = 0 }
			maxWidth = 660
			maxHeight = 18
			text = "bloc_add <nume> <TAG> [alte tag-uri]       ex: bloc_add puterile_centrale GER AUS TUR BUL"
			format = left
			fixedsize = yes
		}
		instantTextBoxType = {
			name = "v2cmd_line18"
			position = { x = 30 y = 404 }
			font = "Arial12"
			borderSize = { x = 0 y = 0 }
			maxWidth = 660
			maxHeight = 18
			text = "bloc_remove <TAG>     bloc_list [nume]     bloc_disband <nume>"
			format = left
			fixedsize = yes
		}
		instantTextBoxType = {
			name = "v2cmd_line19"
			position = { x = 30 y = 424 }
			font = "Arial12"
			borderSize = { x = 0 y = 0 }
			maxWidth = 660
			maxHeight = 18
			text = "Intr-un razboi, toti membrii vii intra de partea membrului implicat. Blocul se pastreaza in salvare."
			format = left
			fixedsize = yes
		}
		instantTextBoxType = {
			name = "v2cmd_line21"
			position = { x = 30 y = 454 }
			font = "Arial12"
			borderSize = { x = 0 y = 0 }
			maxWidth = 660
			maxHeight = 18
			text = "Jurnal: the_grand_loader.log langa v2game.exe. Totalurile de populatie se actualizeaza a doua zi."
			format = left
			fixedsize = yes
		}
	}


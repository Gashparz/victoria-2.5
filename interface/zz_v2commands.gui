	# "Invita in bloc" tab on the diplomacy screen (next to the Crisis tab). Shown by TGCConvertPop.dll when
	# the diplomacy screen is open and you are in a bloc. Move it with position (relative to the screen centre,
	# like the diplomacy window itself: x=-512 y=-250).
	windowType = {
		name = "v2bloc_diplo"
		backGround = ""
		position = { x = 153 y = -237 }
		size = { x = 156 y = 34 }
		moveable = 0
		dontRender = ""
		horizontalBorder = ""
		verticalBorder = ""
		fullScreen = no
		Orientation = "CENTER"

		guiButtonType = {
			name = "v2bloc_invite"
			position = { x = 0 y = 0 }
			quadTextureSprite = "GFX_prod_tab_button"
			clicksound = click
		}
		instantTextBoxType = {
			name = "v2bloc_invite_text"
			position = { x = 3 y = 8 }
			font = "vic_18_black"
			borderSize = { x = 0 y = 0 }
			text = "Invita in bloc"
			maxWidth = 148
			maxHeight = 20
			format = centre
			fixedsize = yes
		}
	}
